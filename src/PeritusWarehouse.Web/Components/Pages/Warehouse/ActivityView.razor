@inject IBcClient Bc
@using PeritusWarehouse.Web.Services

<div class="pw-topbar">
    <a href="/">&larr; Menu</a>
    @if (OnBack.HasDelegate) { <a href="javascript:void(0)" class="pw-back" @onclick="OnBack">Back</a> }
</div>
<h1>@Title</h1>
@if (_error is not null) { <p class="pw-error">@_error</p> }
@if (_message is not null) { <p class="pw-ok">@_message</p> }

@if (PickLicensePlateWorkflow && ConsolidateByBin)
{
    @if (_showPlace)
    {
        <p><button type="button" class="pw-btn secondary" @onclick="() => _showPlace = false">&larr; Take</button></p>
        <h2>Place</h2>
        @foreach (var plateGroup in GroupPlaceLines())
        {
            var plateEntries = plateGroup.ToList();
            var placeConfirmed = IsPlaceGroupConfirmed(plateGroup.Key);
            <div class="pw-line">
                <h3>License plate @plateGroup.Key</h3>
                @if (placeConfirmed)
                {
                    <p class="pw-ok">Place confirmed</p>
                }
                else
                {
                    <div class="pw-actions">
                        <button type="button" class="pw-btn secondary" disabled="@_busy" @onclick="() => FillPlaceFromTake(plateEntries)">Fill from Take</button>
                        <button type="button" class="pw-btn primary" disabled="@_busy" @onclick="() => ConfirmPlaceAsync(plateEntries)">Confirm Place</button>
                    </div>
                }
                @foreach (var entry in plateEntries.OrderBy(x => x.BinCode, StringComparer.OrdinalIgnoreCase).ThenBy(x => x.ActivityNumber).ThenBy(x => x.ActivityLineNumber))
                {
                    <div class="pw-line">
                        <div><strong>Bin @entry.BinCode</strong> @entry.ZoneCode &middot; @entry.ActivityNumber</div>
                        <div>@entry.ItemNo</div>
                        <div>
                            Take @entry.TakeQuantity @UnitFor(entry)
                            @if (entry.PlaceQuantity != 0) { <span> &middot; Placed @entry.PlaceQuantity</span> }
                            @if (entry.PostedQuantity != 0) { <span> &middot; Posted @entry.PostedQuantity</span> }
                        </div>
                        @if (!placeConfirmed)
                        {
                            <input class="pw-input" type="number" step="any" min="@entry.PostedQuantity" max="@entry.TakeQuantity" inputmode="decimal" @bind="entry.PlaceEntry" />
                        }
                    </div>
                }
            </div>
        }
        <h2>Register per pick list</h2>
        @foreach (var activity in _list)
        {
            <div class="pw-line">
                <strong>@activity.Number</strong>
                <button type="button" class="pw-btn primary" disabled="@(_busy || !CanRegisterPick(activity))" @onclick="() => RegisterPickAsync(activity)">
                    Register @activity.Number
                </button>
            </div>
        }
    }
    else if (_list.Count == 0)
    {
        <p>All pick lists in this batch have been registered.</p>
        <button type="button" class="pw-btn secondary" @onclick="OnBack">Back to patterns</button>
    }
    else
    {
        <p>@_list.Count pick list(s) remaining. Choose a license plate for each Take; register separately per pick list.</p>
        <div class="pw-actions">
            <button type="button" class="pw-btn secondary" disabled="@_busy" @onclick="OpenPlaceAsync">Place (@_licensePlateLines.Count)</button>
        </div>
        @foreach (var entry in _combinedLines
            .Where(x => x.Line.ActionType == 1 && !IsLicensePlateConfirmed(GetSelectedLicensePlate(x.Activity)))
            .OrderBy(x => x.Line.BinCode, StringComparer.OrdinalIgnoreCase)
            .ThenBy(x => x.Line.ItemNo, StringComparer.OrdinalIgnoreCase)
            .ThenBy(x => x.Activity.Number, StringComparer.OrdinalIgnoreCase)
            .ThenBy(x => x.Line.LineNumber))
        {
            <div class="pw-line">
                <div><strong>Bin @entry.Line.BinCode</strong> @entry.Line.ZoneCode &middot; @entry.Activity.Number</div>
                <div><strong>Take</strong> @entry.Line.ItemNo @entry.Line.Description</div>
                <div>Qty @entry.Line.Quantity @entry.Line.Unit &middot; Remaining @TakeRemaining(entry)</div>
                <div class="pw-actions">
                    <select class="pw-input" value="@GetSelectedLicensePlate(entry.Activity)" @onchange="e => SetSelectedLicensePlateAsync(entry.Activity, e.Value?.ToString())">
                        <option value="">Select license plate</option>
                        @foreach (var plate in AvailableLicensePlates) { <option value="@plate.Number">@plate.Number</option> }
                    </select>
                    <button type="button" class="pw-btn secondary" disabled="@_busy" @onclick="() => CreateLicensePlateAsync(entry.Activity)">New license plate</button>
                </div>
                <input class="pw-input" type="number" step="any" min="0" max="@TakeRemaining(entry)" inputmode="decimal" @bind="entry.Line.PickEntry" />
                <button type="button" class="pw-btn primary" disabled="@_busy" @onclick="() => SaveTakeAsync(entry.Activity, entry.Line)">Confirm Take</button>
            </div>
        }
    }
}
else if (PickLicensePlateWorkflow && _active is not null)
{
    @if (_showPlace)
    {
        <p><button type="button" class="pw-btn secondary" @onclick="() => _showPlace = false">&larr; Take</button></p>
        <h2>Place</h2>
        @foreach (var plateGroup in GroupPlaceLines())
        {
            var plateEntries = plateGroup.ToList();
            var placeConfirmed = IsPlaceGroupConfirmed(plateGroup.Key);
            <div class="pw-line">
                <h3>License plate @plateGroup.Key</h3>
                @if (placeConfirmed)
                {
                    <p class="pw-ok">Place confirmed</p>
                }
                else
                {
                    <div class="pw-actions">
                        <button type="button" class="pw-btn secondary" disabled="@_busy" @onclick="() => FillPlaceFromTake(plateEntries)">Fill from Take</button>
                        <button type="button" class="pw-btn primary" disabled="@_busy" @onclick="() => ConfirmPlaceAsync(plateEntries)">Confirm Place</button>
                    </div>
                }
                @foreach (var entry in plateEntries.OrderBy(x => x.BinCode, StringComparer.OrdinalIgnoreCase).ThenBy(x => x.ActivityNumber).ThenBy(x => x.ActivityLineNumber))
                {
                    <div class="pw-line">
                        <div><strong>Bin @entry.BinCode</strong> @entry.ZoneCode &middot; @entry.ActivityNumber</div>
                        <div>@entry.ItemNo</div>
                        <div>
                            Take @entry.TakeQuantity @UnitFor(entry)
                            @if (entry.PlaceQuantity != 0) { <span> &middot; Placed @entry.PlaceQuantity</span> }
                            @if (entry.PostedQuantity != 0) { <span> &middot; Posted @entry.PostedQuantity</span> }
                        </div>
                        @if (!placeConfirmed)
                        {
                            <input class="pw-input" type="number" step="any" min="@entry.PostedQuantity" max="@entry.TakeQuantity" inputmode="decimal" @bind="entry.PlaceEntry" />
                        }
                    </div>
                }
            </div>
        }
        <button type="button" class="pw-btn primary" disabled="@(_busy || !CanRegisterPick(_active))" @onclick="() => RegisterPickAsync(_active)">Register @_active.Number</button>
    }
    else
    {
        <p><button type="button" class="pw-btn secondary" @onclick="Back">&larr; List</button> <strong>@_active.Number</strong></p>
        <div class="pw-actions">
            <select class="pw-input" value="@GetSelectedLicensePlate(_active)" @onchange="e => SetSelectedLicensePlateAsync(_active, e.Value?.ToString())">
                <option value="">Select license plate</option>
                @foreach (var plate in AvailableLicensePlates) { <option value="@plate.Number">@plate.Number</option> }
            </select>
            <button type="button" class="pw-btn secondary" disabled="@_busy" @onclick="() => CreateLicensePlateAsync(_active)">New license plate</button>
            <button type="button" class="pw-btn secondary" disabled="@_busy" @onclick="OpenPlaceAsync">Place (@_licensePlateLines.Count)</button>
        </div>
        @foreach (var l in _lines.Where(l => l.ActionType == 1 && !IsLicensePlateConfirmed(GetSelectedLicensePlate(_active))).OrderBy(l => l.BinCode, StringComparer.OrdinalIgnoreCase).ThenBy(l => l.LineNumber))
        {
            <div class="pw-line">
                <div><strong>Take</strong> @l.ItemNo @l.Description</div>
                <div>Bin @l.BinCode @l.ZoneCode &middot; Qty @l.Quantity @l.Unit &middot; Remaining @TakeRemaining(_active, l)</div>
                <input class="pw-input" type="number" step="any" min="0" max="@TakeRemaining(_active, l)" inputmode="decimal" @bind="l.PickEntry" />
                <button type="button" class="pw-btn primary" disabled="@_busy" @onclick="() => SaveTakeAsync(_active, l)">Confirm Take</button>
            </div>
        }
    }
}
else if (_active is null)
{
    @if (_loaded && _list.Count == 0) { <p>No open @Title.ToLower() found.</p> }
    <div class="pw-menu">
        @foreach (var a in _list)
        {
            var remainingPick = PickLicensePlateWorkflow ? RemainingPick(a) : 0;
            <button type="button" class="pw-tile @(_loaded && PickLicensePlateWorkflow && remainingPick == 0 ? "no-remaining-pick" : "")" disabled="@_busy" @onclick="() => OpenAsync(a)">
                @a.Number<br />
                <small>@a.LocationCode</small>
                @if (PickLicensePlateWorkflow)
                {
                    <small>@remainingPick</small>
                }
            </button>
        }
    </div>
}
else
{
    <p><button type="button" class="pw-btn secondary" @onclick="Back">&larr; List</button> <strong>@_active.Number</strong></p>
    @foreach (var l in _lines.OrderBy(l => l.LineNumber))
    {
        <div class="pw-line">
            <div><strong>@(l.ActionType == 1 ? "Take" : "Place")</strong> @l.ItemNo @l.Description</div>
            <div>Bin @l.BinCode @l.ZoneCode &middot; Qty @l.Quantity @l.Unit &middot; Open @l.Outstanding</div>
            <input class="pw-input" type="number" step="any" min="0" max="@l.Outstanding" inputmode="decimal" @bind="l.Entry" />
            <button type="button" class="pw-btn secondary" @onclick="() => l.Entry = l.Outstanding">All</button>
        </div>
    }
    <button class="pw-btn primary" disabled="@_busy" @onclick="RegisterAsync">Register</button>
}

@code {
    [Parameter, EditorRequired] public string Kind { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    // Set for pick batches created from a pattern; the list is then these activities only.
    [Parameter] public List<WhseActivity>? Preset { get; set; }
    [Parameter] public bool ConsolidateByBin { get; set; }
    [Parameter] public bool PickLicensePlateWorkflow { get; set; }
    [Parameter] public Guid BatchId { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private List<WhseActivity> _list = [];
    private List<PickLineView> _combinedLines = [];
    private readonly Dictionary<Guid, List<WhseLine>> _pickLinesByActivity = [];
    private List<PickLicensePlate> _licensePlates = [];
    private List<PickLicensePlateLine> _licensePlateLines = [];
    private WhseActivity? _active;
    private List<WhseLine> _lines = [];
    private string? _error, _message;
    private bool _busy, _loaded, _showPlace;

    protected override async Task OnInitializedAsync() => await LoadListAsync();

    private async Task LoadListAsync()
    {
        _busy = true;
        try
        {
            _list = Preset ?? await Bc.GetWhseActivitiesAsync(Kind);
            if (PickLicensePlateWorkflow && BatchId != Guid.Empty)
            {
                _licensePlates = await Bc.GetPickLicensePlatesAsync(BatchId);
                _licensePlateLines = await Bc.GetPickLicensePlateLinesAsync(BatchId);
                await ClearConfirmedActiveLicensePlatesAsync();
            }
            if (ConsolidateByBin)
            {
                foreach (var activity in _list)
                {
                    var lines = await Bc.GetWhseLinesAsync(Kind, activity.Number);
                    foreach (var line in lines)
                    {
                        line.PickEntry = null;
                        _combinedLines.Add(new PickLineView(activity, line));
                    }
                }
            }
            else if (PickLicensePlateWorkflow)
            {
                foreach (var activity in _list)
                    _pickLinesByActivity[activity.Id] = await Bc.GetWhseLinesAsync(Kind, activity.Number);
            }
            _loaded = true;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void Back() { _active = null; _lines = []; _error = null; }

    private async Task OpenAsync(WhseActivity a)
    {
        _error = _message = null; _busy = true;
        try
        {
            _lines = PickLicensePlateWorkflow && _pickLinesByActivity.TryGetValue(a.Id, out var savedLines)
                ? savedLines
                : await Bc.GetWhseLinesAsync(Kind, a.Number);
            foreach (var l in _lines)
            {
                l.Entry = l.QtyToHandle;
                l.PickEntry = null;
            }
            _active = a;
            _showPlace = false;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RegisterAsync()
    {
        if (_active is null) return;
        _error = _message = null;
        if (_lines.Any(l => l.Entry < 0 || l.Entry > l.Outstanding)) { _error = "Quantity exceeds what is outstanding."; return; }
        _busy = true;
        try
        {
            await Bc.RegisterWhseActivityAsync(Kind, _active.Id, _lines);
            _message = $"{_active.Number} registered.";
            var done = _active.Id;
            _active = null; _lines = [];
            if (Preset is null) _list = await Bc.GetWhseActivitiesAsync(Kind);
            else _list.Remove(_list.First(x => x.Id == done));
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RegisterCombinedAsync(WhseActivity activity)
    {
        var lines = _combinedLines
            .Where(x => x.Activity.Id == activity.Id)
            .Select(x => x.Line)
            .ToList();
        if (lines.Any(l => l.Entry < 0 || l.Entry > l.Outstanding))
        {
            _error = "Quantity exceeds what is outstanding.";
            return;
        }

        _error = _message = null;
        _busy = true;
        try
        {
            await Bc.RegisterWhseActivityAsync(Kind, activity.Id, lines);
            _combinedLines.RemoveAll(x => x.Activity.Id == activity.Id);
            _list.RemoveAll(x => x.Id == activity.Id);
            _message = $"{activity.Number} registered.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task CreateLicensePlateAsync(WhseActivity activity)
    {
        if (BatchId == Guid.Empty)
        {
            _error = "This pick is not associated with a pick batch.";
            return;
        }
        _error = null;
        _busy = true;
        try
        {
            var plate = await Bc.CreatePickLicensePlateAsync(BatchId);
            _licensePlates.Add(plate);
            await SetSelectedLicensePlateAsync(activity, plate.Number);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SaveTakeAsync(WhseActivity activity, WhseLine line)
    {
        _error = null;
        var licensePlateNo = GetSelectedLicensePlate(activity);
        if (string.IsNullOrWhiteSpace(licensePlateNo))
        {
            _error = "Select or create a license plate before confirming Take.";
            return;
        }
        if (IsLicensePlateConfirmed(licensePlateNo))
        {
            _error = "A Place-confirmed license plate cannot be used for Take.";
            return;
        }
        var quantity = line.PickEntry ?? 0;
        if (quantity <= 0 || quantity > TakeRemaining(activity, line))
        {
            _error = "Take quantity must be greater than zero and cannot exceed the remaining quantity.";
            return;
        }
        _busy = true;
        try
        {
            await Bc.AddPickTakeAsync(BatchId, licensePlateNo, line, quantity);
            line.PickEntry = null;
            await RefreshLicensePlateDataAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task OpenPlaceAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            await RefreshLicensePlateDataAsync();
            foreach (var entry in _licensePlateLines)
                entry.PlaceEntry = entry.PlaceQuantity == 0 ? null : entry.PlaceQuantity;
            _showPlace = true;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private static void FillPlaceFromTake(List<PickLicensePlateLine> entries)
    {
        foreach (var entry in entries)
            entry.PlaceEntry = entry.TakeQuantity;
    }

    private async Task ConfirmPlaceAsync(List<PickLicensePlateLine> entries)
    {
        _error = _message = null;
        if (entries.Count == 0)
            return;
        if (entries.Any(entry => (entry.PlaceEntry ?? 0) < entry.PostedQuantity || (entry.PlaceEntry ?? 0) > entry.TakeQuantity))
        {
            _error = "Each Place quantity must be between its posted quantity and the quantity taken.";
            return;
        }
        var licensePlate = _licensePlates.FirstOrDefault(plate =>
            string.Equals(plate.Number, entries[0].LicensePlateNumber, StringComparison.OrdinalIgnoreCase));
        if (licensePlate is null)
        {
            _error = $"License plate {entries[0].LicensePlateNumber} was not found in this pick batch.";
            return;
        }
        _busy = true;
        try
        {
            foreach (var entry in entries)
            {
                var placeQuantity = entry.PlaceEntry ?? 0;
                await Bc.SetPickPlaceAsync(entry.Id, placeQuantity);
                entry.PlaceQuantity = placeQuantity;
            }
            await Bc.ConfirmPickLicensePlateAsync(licensePlate.Id);
            licensePlate.PlaceConfirmed = true;
            await ClearConfirmedActiveLicensePlatesAsync();
            _message = $"Place quantities saved and confirmed for license plate {licensePlate.Number}.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private IEnumerable<IGrouping<string, PickLicensePlateLine>> GroupPlaceLines()
    {
        var lines = _licensePlateLines.AsEnumerable();
        if (!ConsolidateByBin && _active is not null)
            lines = lines.Where(line => line.ActivityNumber == _active.Number);
        return lines
            .GroupBy(line => line.LicensePlateNumber, StringComparer.OrdinalIgnoreCase)
            .OrderBy(group => IsPlaceGroupConfirmed(group.Key))
            .ThenBy(group => group.Key, StringComparer.OrdinalIgnoreCase);
    }

    private bool IsPlaceGroupConfirmed(string licensePlateNumber) =>
        IsLicensePlateConfirmed(licensePlateNumber);

    private IEnumerable<PickLicensePlate> AvailableLicensePlates =>
        _licensePlates.Where(plate => !plate.PlaceConfirmed);

    private bool IsLicensePlateConfirmed(string? licensePlateNumber) =>
        !string.IsNullOrWhiteSpace(licensePlateNumber) &&
        _licensePlates.Any(plate =>
            plate.PlaceConfirmed && string.Equals(plate.Number, licensePlateNumber, StringComparison.OrdinalIgnoreCase));

    private async Task ClearConfirmedActiveLicensePlatesAsync()
    {
        foreach (var activity in _list.Where(activity => IsLicensePlateConfirmed(activity.ActiveLicensePlateNumber)).ToList())
        {
            await Bc.SetPickActiveLicensePlateAsync(activity.Id, "");
            activity.ActiveLicensePlateNumber = null;
        }
    }

    private async Task RegisterPickAsync(WhseActivity activity)
    {
        _error = _message = null;
        _busy = true;
        try
        {
            await Bc.RegisterPickActivityAsync(activity.Id);
            _message = $"{activity.Number} registered.";
            _list = await Bc.GetPickBatchActivitiesAsync(BatchId);
            _combinedLines.Clear();
            _pickLinesByActivity.Clear();
            if (ConsolidateByBin)
                foreach (var openActivity in _list)
                    foreach (var line in await Bc.GetWhseLinesAsync(Kind, openActivity.Number))
                        _combinedLines.Add(new PickLineView(openActivity, line));
            else if (PickLicensePlateWorkflow)
                foreach (var openActivity in _list)
                    _pickLinesByActivity[openActivity.Id] = await Bc.GetWhseLinesAsync(Kind, openActivity.Number);
            if (_active is not null)
            {
                _active = _list.FirstOrDefault(x => x.Id == activity.Id);
                if (_active is not null)
                    _lines = await Bc.GetWhseLinesAsync(Kind, _active.Number);
            }
            await RefreshLicensePlateDataAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RefreshLicensePlateDataAsync()
    {
        _licensePlates = await Bc.GetPickLicensePlatesAsync(BatchId);
        _licensePlateLines = await Bc.GetPickLicensePlateLinesAsync(BatchId);
    }

    private decimal TakeRemaining(PickLineView entry) => TakeRemaining(entry.Activity, entry.Line);

    private decimal Taken(PickLineView entry) => Taken(entry.Activity, entry.Line);

    private decimal Taken(WhseActivity activity, WhseLine line) =>
        _licensePlateLines.Where(x => x.ActivityNumber == activity.Number && x.ActivityLineNumber == line.LineNumber)
            .Sum(x => x.TakeQuantity - x.PostedQuantity);

    private decimal TakeRemaining(WhseActivity activity, WhseLine line) =>
        Math.Max(0, line.Outstanding - Taken(activity, line));

    private decimal RemainingPick(WhseActivity activity)
    {
        if (!_pickLinesByActivity.TryGetValue(activity.Id, out var lines))
            return 0;
        return lines.Where(line => line.ActionType == 1).Sum(line => TakeRemaining(activity, line));
    }

    private static string GetSelectedLicensePlate(WhseActivity activity) =>
        activity.ActiveLicensePlateNumber ?? "";

    private async Task SetSelectedLicensePlateAsync(WhseActivity activity, string? licensePlateNo)
    {
        var selection = licensePlateNo?.Trim() ?? "";
        _error = null;
        if (IsLicensePlateConfirmed(selection))
        {
            _error = "A Place-confirmed license plate cannot be selected for Take.";
            return;
        }
        _busy = true;
        try
        {
            await Bc.SetPickActiveLicensePlateAsync(activity.Id, selection);
            activity.ActiveLicensePlateNumber = selection;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private bool HasPlaceToRegister(WhseActivity activity) =>
        _licensePlateLines.Any(x => x.ActivityNumber == activity.Number && x.PlaceQuantity > x.PostedQuantity);

    private bool CanRegisterPick(WhseActivity activity)
    {
        var takenLines = _licensePlateLines
            .Where(x => x.ActivityNumber == activity.Number)
            .GroupBy(x => x.ActivityLineNumber)
            .ToList();
        return takenLines.Count > 0 &&
            takenLines.All(line => line.Sum(x => x.TakeQuantity) == line.Sum(x => x.PlaceQuantity)) &&
            HasPlaceToRegister(activity);
    }

    private static string UnitFor(PickLicensePlateLine entry) => entry.Unit ?? "";

    private sealed record PickLineView(WhseActivity Activity, WhseLine Line);
}
