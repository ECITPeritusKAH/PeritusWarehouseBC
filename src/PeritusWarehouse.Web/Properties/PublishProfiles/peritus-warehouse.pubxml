<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <MSDeployServiceURL>peritus-warehouse.scm.azurewebsites.net:443</MSDeployServiceURL>
    <DeployIisAppPath>peritus-warehouse</DeployIisAppPath>
    <PublishProvider>AzureWebSite</PublishProvider>
    <PublishUrl>https://peritus-warehouse.scm.azurewebsites.net:443</PublishUrl>
    <SiteUrlToLaunchAfterPublish>https://peritus-warehouse.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <SkipExtraFilesOnServer>True</SkipExtraFilesOnServer>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <_DestinationType>AzureWebSite</_DestinationType>
    <_SavePWD>false</_SavePWD>
  </PropertyGroup>
</Project>
